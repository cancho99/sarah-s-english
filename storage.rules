// Firebase Storage rules for the "sarah-s-english" project.
// Homework attachments use authenticated per-student paths.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /homeworkMedia/{studentId}/{homeworkId}/{fileName} {
      function teacher() { return request.auth != null && request.auth.token.role == "teacher"; }
      function own(role) { return request.auth != null && request.auth.token.role == role && request.auth.token.studentId == studentId; }
      allow read: if teacher() || own("student");
      allow create: if (teacher() || own("student")) && (
        (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 5 * 1024 * 1024) ||
        (request.resource.contentType.matches('audio/(webm|mp4|mpeg|wav|x-wav|ogg|aac|x-m4a)(;.*)?') && request.resource.size <= 15 * 1024 * 1024)
      );
      allow delete: if teacher() || own("student");
      allow update: if false;
    }
  }
}
